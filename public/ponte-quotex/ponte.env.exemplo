# Copie este arquivo para "ponte.env" (na mesma pasta) e preencha. Ele fica só no seu computador.
BOT_URL=https://bot.77.42.120.142.sslip.io
# o token que o painel mostrou ao criar a conta Quotex (trate como senha)
PONTE_TOKEN=
# seu login da Quotex: usado só aqui, para a ponte entrar na conta; nunca vai para o bot
QUOTEX_EMAIL=
QUOTEX_SENHA=
# demo = conta de treino da Quotex (padrão). real = dinheiro de verdade: o bot também precisa das
# três chaves (BOT_LIVE_ENABLED, conta real e estratégia real) para mandar aposta real
PONTE_CONTA=demo
# teto por aposta: a ponte recusa aposta maior, mesmo que o bot mande
PONTE_VALOR_MAX=10
# só se o endereço padrão da Quotex estiver bloqueado na sua internet (ex.: qxbroker.com)
QUOTEX_HOST=
