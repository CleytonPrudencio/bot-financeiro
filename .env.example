# Variáveis do Bot Financeiro. Na VM, o primeiro deploy gera /opt/bot-financeiro/.env sozinho com
# valores aleatórios; este arquivo serve para rodar local. Nunca faça commit do .env de verdade.

# local: postgres://usuario:senha@localhost:5432/bot   (na VM o compose monta a partir de BOT_DB_PASSWORD)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bot
BOT_DB_PASSWORD=

# assina o cookie do painel. Gere com: openssl rand -hex 32
BOT_SESSION_SECRET=
# cifra as chaves de API das exchanges no banco. Gere com: openssl rand -hex 32
# Guarde uma cópia FORA da VM: sem ela, as chaves cadastradas não abrem mais.
BOT_ENCRYPTION_KEY=

# Primeira das três chaves do dinheiro real. Deixe false até decidir operar de verdade.
BOT_LIVE_ENABLED=false

# endereço público, usado para montar a URL do webhook no painel
BOT_PUBLIC_URL=http://localhost:3000
PORT=3000
